# ============================================
# Rama Jewellers — Environment Variables
# ============================================

# ── Server-side (Vercel environment variables) ──
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# NEVER put the actual value in this file or commit it to git.
GOLDAPI_KEY=

# ── Client-side (VITE_ prefix — safe to expose in browser bundle) ──
# EmailJS credentials for contact/order email notifications
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
