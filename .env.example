VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Server-side only (set in Netlify site settings, not exposed to the browser).
# Used by netlify/functions/gold-rates.cjs and refresh-gold-rates.mjs to fetch
# live gold prices from GoldAPI.io. Without it, live rates still work via the
# goldprice.org fallback.
GOLDAPI_KEY=your_goldapi_key
